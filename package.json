{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "node scripts/dev-pages.mjs",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json",
    "test:boarding": "node scripts/boarding-api.test.mjs",
    "test:counts": "node scripts/count-api.test.mjs",
    "test:session": "node scripts/session-controller.test.mjs",
    "test:loads": "node scripts/latest-load.test.mjs",
    "test:weights": "node scripts/weights-api.test.mjs",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev --port 8790",
    "pages:baseline": "wrangler pages dev --ip 127.0.0.1 --port 8791 --persist-to .wrangler/performance-baseline --binding LOCAL_DEV_FULL_ACCESS=false",
    "db:migrate:baseline": "wrangler d1 migrations apply k9_ops_db --local --persist-to .wrangler/performance-baseline",
    "db:migrate:local": "wrangler d1 migrations apply k9_ops_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply k9_ops_db --remote",
    "db:seed:local": "wrangler d1 execute k9_ops_db --local --file scripts/seed-local-subscription.sql",
    "db:reset:local": "node -e \"require('node:fs').rmSync('.wrangler/state', { recursive: true, force: true })\"",
    "format": "oxfmt"
  },
  "dependencies": {
    "dodopayments": "^2.54.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.54.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
