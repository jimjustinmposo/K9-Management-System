# Documentation only: Pages Functions use Cloudflare bindings, not Vite env vars.
# For local Pages testing, copy the relevant values into ignored .dev.vars.
# Use production for live payments. Keys/tokens must match the environment.
# Never use VITE_ for secrets.
PADDLE_ENVIRONMENT=production
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_MONTHLY_PRICE_ID=
PADDLE_YEARLY_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
# Set PADDLE_CHECKOUT_ENABLED=true to allow new checkouts.
# Live/staging switch after testing: live_ client token, live API key,
# mapped live price IDs, and the EXISTING live destination secret.
# Never rotate or recreate a notification destination during migration.
# Do not deploy live checkout for customers until verification/domain approval.